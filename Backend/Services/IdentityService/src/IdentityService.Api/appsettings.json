{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Identity": {
    "Jwt": {
      "Issuer": "SmartCampusOS",
      "Audience": "SmartCampusOS.Clients",
      "SigningKey": "change-me-in-production-32bytes-min",
      "AccessTokenMinutes": 120,
      "RefreshTokenDays": 7
    },
    "Database": {
      "ConnectionString": "Server=localhost;Port=3306;Database=identity_db;Uid=root;Pwd=root;Charset=utf8mb4;SslMode=None;AllowPublicKeyRetrieval=True",
      "SyncStructureOnStartup": true
    },
    "Redis": {
      "ConnectionString": "localhost:6379,abortConnect=false"
    },
    "RabbitMq": {
      "Enabled": false,
      "Host": "localhost",
      "VirtualHost": "/",
      "Username": "guest",
      "Password": "guest"
    },
    "Captcha": {
      "Enabled": true,
      "TestCodeEnabled": true,
      "TestCode": "123456",
      "Length": 6,
      "TtlSeconds": 300
    },
    "Encryption": {
      "AesKey": "dev-only-aes-key-change-me"
    },
    "Seed": {
      "AdminUserNo": "admin",
      "AdminPassword": "Admin@123",
      "AdminRealName": "系统管理员"
    }
  }
}
