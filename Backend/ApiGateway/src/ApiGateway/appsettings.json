{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Whitelist": [
      "/health",
      "/api/v1/auth/login",
      "/api/v1/auth/refresh",
      "/api/v1/sso/exchange",
      "/api/v1/cards/transactions/webhook",
      "/api/v1/attendance/events/webhook"
    ],
    "Jwt": {
      "Issuer": "SmartCampusOS",
      "Audience": "SmartCampusOS.Clients",
      "SigningKey": "change-me-in-production-32bytes-min",
      "ClockSkewSeconds": 30
    },
    "Redis": {
      "ConnectionString": "localhost:6379,abortConnect=false",
      "FailOpen": true,
      "ConnectTimeoutSeconds": 3,
      "OperationTimeoutMilliseconds": 500
    },
    "RateLimit": {
      "DefaultRps": 10,
      "WindowSeconds": 1,
      "PathExemptions": [ "/health", "/hubs/" ],
      "Overrides": [
        { "PathPrefix": "/api/v1/selections", "Rps": 100 },
        { "PathPrefix": "/api/v1/scores", "Rps": 30 },
        { "PathPrefix": "/api/v1/dashboards", "Rps": 30 },
        { "PathPrefix": "/api/v1/screens", "Rps": 20 }
      ],
      "FailOpen": true
    },
    "Blacklist": {
      "KeyPrefix": "gateway:token:blacklist",
      "FailOpen": true
    },
    "GrayRelease": {
      "Enabled": false,
      "VersionHeader": "X-Gray-Version",
      "SourceHeader": "X-Gray-Tag",
      "Rules": [
        { "PathPrefix": "/api/v1/schedules", "Percent": 10, "Version": "v2" }
      ]
    },
    "Observability": {
      "Enabled": true,
      "OtlpEndpoint": "http://otel-collector:4317",
      "ServiceName": "ApiGateway"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth":        { "ClusterId": "identity", "Match": { "Path": "/api/v1/auth/{**catchall}" } },
      "identity-users":       { "ClusterId": "identity", "Match": { "Path": "/api/v1/users/{**catchall}" } },
      "identity-orgs":        { "ClusterId": "identity", "Match": { "Path": "/api/v1/orgs/{**catchall}" } },
      "identity-roles":       { "ClusterId": "identity", "Match": { "Path": "/api/v1/roles/{**catchall}" } },
      "identity-me":          { "ClusterId": "identity", "Match": { "Path": "/api/v1/me/{**catchall}" } },
      "identity-audit":       { "ClusterId": "identity", "Match": { "Path": "/api/v1/audit-logs/{**catchall}" } },
      "identity-dicts":       { "ClusterId": "identity", "Match": { "Path": "/api/v1/dicts/{**catchall}" } },
      "identity-parents-bind":{ "ClusterId": "identity", "Match": { "Path": "/api/v1/parents/bind/{**catchall}" } },
      "edu-semesters":        { "ClusterId": "edu", "Match": { "Path": "/api/v1/semesters/{**catchall}" } },
      "edu-schedules":        { "ClusterId": "edu", "Match": { "Path": "/api/v1/schedules/{**catchall}" } },
      "edu-selections":       { "ClusterId": "edu", "Match": { "Path": "/api/v1/selections/{**catchall}" } },
      "edu-scores":           { "ClusterId": "edu", "Match": { "Path": "/api/v1/scores/{**catchall}" } },
      "edu-exams":            { "ClusterId": "edu", "Match": { "Path": "/api/v1/exams/{**catchall}" } },
      "edu-students":         { "ClusterId": "edu", "Match": { "Path": "/api/v1/students/{**catchall}" } },
      "dorm-structure":       { "ClusterId": "dorm", "Match": { "Path": "/api/v1/buildings/{**catchall}" } },
      "dorm-rooms":           { "ClusterId": "dorm", "Match": { "Path": "/api/v1/rooms/{**catchall}" } },
      "dorm-beds":            { "ClusterId": "dorm", "Match": { "Path": "/api/v1/beds/{**catchall}" } },
      "dorm-assignments":     { "ClusterId": "dorm", "Match": { "Path": "/api/v1/dorm-assignments/{**catchall}" } },
      "dorm-repairs":         { "ClusterId": "dorm", "Match": { "Path": "/api/v1/repair-orders/{**catchall}" } },
      "dorm-venues":          { "ClusterId": "dorm", "Match": { "Path": "/api/v1/venues/{**catchall}" } },
      "dorm-meter":           { "ClusterId": "dorm", "Match": { "Path": "/api/v1/meter-readings/{**catchall}" } },
      "dorm-inspections":     { "ClusterId": "dorm", "Match": { "Path": "/api/v1/inspections/{**catchall}" } },
      "notice-announcements": { "ClusterId": "notice", "Match": { "Path": "/api/v1/announcements/{**catchall}" } },
      "notice-messages":      { "ClusterId": "notice", "Match": { "Path": "/api/v1/messages/{**catchall}" } },
      "notice-conversations": { "ClusterId": "notice", "Match": { "Path": "/api/v1/conversations/{**catchall}" } },
      "notice-class-moments": { "ClusterId": "notice", "Match": { "Path": "/api/v1/class-moments/{**catchall}" } },
      "notice-parents-dashboard": { "ClusterId": "notice", "Match": { "Path": "/api/v1/parents/dashboard/{**catchall}" } },
      "notice-subscriptions": { "ClusterId": "notice", "Match": { "Path": "/api/v1/subscriptions/{**catchall}" } },
      "notice-hubs":          { "ClusterId": "notice", "Match": { "Path": "/hubs/{**catchall}" } },
      "data-dashboards":      { "ClusterId": "data", "Match": { "Path": "/api/v1/dashboards/{**catchall}" } },
      "data-screens":         { "ClusterId": "data", "Match": { "Path": "/api/v1/screens/{**catchall}" } },
      "data-reports":         { "ClusterId": "data", "Match": { "Path": "/api/v1/reports/{**catchall}" } },
      "data-metrics":         { "ClusterId": "data", "Match": { "Path": "/api/v1/metrics/{**catchall}" } },
      "push-tasks":           { "ClusterId": "push", "Match": { "Path": "/api/v1/push/{**catchall}" } },
      "files":                { "ClusterId": "files", "Match": { "Path": "/api/v1/files/{**catchall}" } }
    },
    "Clusters": {
      "identity": { "Destinations": { "identity": { "Address": "http://localhost:5111" } } },
      "edu":      { "Destinations": { "edu": { "Address": "http://localhost:5112" } } },
      "dorm":     { "Destinations": { "dorm": { "Address": "http://localhost:5113" } } },
      "notice":   { "Destinations": { "notice": { "Address": "http://localhost:5114" } } },
      "data":     { "Destinations": { "data": { "Address": "http://localhost:5115" } } },
      "push":     { "Destinations": { "push": { "Address": "http://localhost:5116" } } },
      "files":    { "Destinations": { "files": { "Address": "http://localhost:5117" } } }
    }
  }
}
